{
  "Authentication": {
    "Authority": "http://localhost:5265",
    "Audience": "orderservice",
    "RequireHttpsMetadata": false,
    "AllowInsecureHttps": false
  },
  "IdentityClient": {
    "Authority": "http://localhost:5265",    
    "ClientId": "order-service",             
    "ClientSecret": "order-secret",          
    "RequestTimeoutSeconds": 10              
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=password;Include Error Detail=true;"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "orders-exchange",
    "ExchangeType": "topic"
  },
  "ProductService": {
    "BaseAddress": "http://localhost:5157",
    "TimeoutSeconds": 5,
    "MaxRetryAttempts": 3,
    "CircuitBreakerDurationSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authentication.JwtBearer": "Debug",
      "Microsoft.IdentityModel": "Debug",
      "System.IdentityModel.Tokens.Jwt": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.AspNetCore.Authentication": "Debug",
        "Microsoft.AspNetCore.Authentication.JwtBearer": "Debug",
        "Microsoft.IdentityModel": "Debug",
        "System.IdentityModel.Tokens.Jwt": "Debug"
      }
    }
  },
  "AllowedHosts": "*"
}
